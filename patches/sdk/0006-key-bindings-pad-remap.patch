diff --git a/src/input/xinput/xinput_input_driver.cpp b/src/input/xinput/xinput_input_driver.cpp
index 844612b..ff3174f 100644
--- a/src/input/xinput/xinput_input_driver.cpp
+++ b/src/input/xinput/xinput_input_driver.cpp
@@ -21,6 +21,10 @@
 #include <rex/ui/virtual_key.h>
 #include <xinput.h>  // NOLINT(build/include_order)
 
+#include <algorithm>
+
+REXCVAR_DEFINE_STRING(pad_remap, "", "Input", "Controller button remap: FROM=TO pairs, e.g. A=B,B=A");
