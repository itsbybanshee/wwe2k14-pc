+// A binding is a comma-separated list of key names ("Space,K"); any of them presses the button. "Shift" and "Control"
+// also match the left / right keys.
 static bool IsBindPressed(const bool (&key_down)[256], const std::string& cvar_val) {
-  VirtualKey vk = rex::ui::ParseVirtualKey(cvar_val);
-  if (vk == VirtualKey::kNone)
-    return false;
-  uint16_t idx = static_cast<uint16_t>(vk);
-  return idx < 256 && key_down[idx];
+  auto down = [&](VirtualKey vk) {
+    uint16_t idx = static_cast<uint16_t>(vk);
+    return idx < 256 && key_down[idx];
+  };
+  size_t start = 0;
+  while (start <= cvar_val.size()) {
+    size_t end = cvar_val.find(',', start);
+    if (end == std::string::npos)
+      end = cvar_val.size();
+    std::string name = cvar_val.substr(start, end - start);
+    while (!name.empty() && name.front() == ' ')
+      name.erase(name.begin());
+    while (!name.empty() && name.back() == ' ')
+      name.pop_back();
+    if (name == "Shift") {
+      if (down(VirtualKey::kShift) || down(VirtualKey::kLShift) || down(VirtualKey::kRShift))
+        return true;
+    } else if (name == "Control") {
+      if (down(VirtualKey::kControl) || down(VirtualKey::kLControl) || down(VirtualKey::kRControl))
+        return true;
+    } else if (!name.empty()) {
+      VirtualKey vk = rex::ui::ParseVirtualKey(name);
+      if (vk != VirtualKey::kNone && down(vk))
+        return true;
+    }
+    start = end + 1;
+  }
+  return false;
 }
 
