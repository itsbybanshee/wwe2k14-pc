+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/logging/api.h>
+#include <rex/thread.h>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <elf.h>
+#include <execinfo.h>
+#include <fcntl.h>
+#include <link.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+
+namespace rex::diagnostics::freeze_logger {
+namespace {
+
+constexpr uint32_t kRingSize = 4096;
+constexpr int kMaxThreads = 64;
+constexpr uint32_t kMaxCaptureDepth = 24;
+constexpr int kFreezeGapSeconds = 10;
