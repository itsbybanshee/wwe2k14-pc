diff --git a/cmake/toolchains/win-amd64-xwin.cmake b/cmake/toolchains/win-amd64-xwin.cmake
new file mode 100644
index 0000000..79f4415
--- /dev/null
+++ b/cmake/toolchains/win-amd64-xwin.cmake
@@ -0,0 +1,96 @@
+# Cross-compile ReXGlue (and games built on it) for Windows x64 from Linux.
+#
+# Compiler: LLVM clang/clang++ (GNU-style driver, MSVC ABI), same driver as the
+# native win-amd64 preset. Linker: lld-link. Windows SDK + MSVC CRT: an xwin
+# splat (`xwin --accept-license splat --output <dir>`).
+#
+# Inputs (cache or environment):
+#   XWIN_DIR   xwin splat output (default: $ENV{XWIN_DIR} or $HOME/xwin)
+#   LLVM_BIN   directory with clang, lld-link, llvm-lib, llvm-rc, llvm-mt
+#              (default: $ENV{LLVM_BIN} or /usr/lib/llvm-20/bin)
+
+set(CMAKE_SYSTEM_NAME Windows)
+set(CMAKE_SYSTEM_VERSION 10.0)
+set(CMAKE_SYSTEM_PROCESSOR AMD64)
+
+if(NOT XWIN_DIR)
+  if(DEFINED ENV{XWIN_DIR})
+    set(XWIN_DIR "$ENV{XWIN_DIR}")
+  else()
+    set(XWIN_DIR "$ENV{HOME}/xwin")
+  endif()
+endif()
+if(NOT LLVM_BIN)
+  if(DEFINED ENV{LLVM_BIN})
+    set(LLVM_BIN "$ENV{LLVM_BIN}")
+  else()
+    set(LLVM_BIN "/usr/lib/llvm-20/bin")
+  endif()
+endif()
+set(XWIN_DIR "${XWIN_DIR}" CACHE PATH "xwin splat directory")
+set(LLVM_BIN "${LLVM_BIN}" CACHE PATH "LLVM tools directory")
+# try_compile() projects re-read this file; forward the two inputs to them.
+list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XWIN_DIR LLVM_BIN)
+
+if(NOT EXISTS "${XWIN_DIR}/sdk/include/um/windows.h")
+  message(FATAL_ERROR "Windows SDK not found in XWIN_DIR='${XWIN_DIR}' (run xwin splat)")
+endif()
+
+set(_triple x86_64-pc-windows-msvc)
+set(CMAKE_C_COMPILER   "${LLVM_BIN}/clang")
+set(CMAKE_CXX_COMPILER "${LLVM_BIN}/clang++")
+set(CMAKE_C_COMPILER_TARGET   ${_triple})
+set(CMAKE_CXX_COMPILER_TARGET ${_triple})
+set(CMAKE_ASM_COMPILER_TARGET ${_triple})
+set(CMAKE_LINKER "${LLVM_BIN}/lld-link")
+# The GNU-style driver makes CMake call the archiver ar-style (qc); lld-link reads these archives.
+set(CMAKE_AR     "${LLVM_BIN}/llvm-ar")
+set(CMAKE_RANLIB "${LLVM_BIN}/llvm-ranlib")
+set(CMAKE_RC_COMPILER "${LLVM_BIN}/llvm-rc")
+set(CMAKE_MT     "${LLVM_BIN}/llvm-mt")
+
+set(_inc
+  "${XWIN_DIR}/crt/include"
+  "${XWIN_DIR}/sdk/include/ucrt"
+  "${XWIN_DIR}/sdk/include/um"
+  "${XWIN_DIR}/sdk/include/shared"
+  "${XWIN_DIR}/sdk/include/winrt")
+# The SDK/CRT headers must come AFTER clang's resource headers (what clang-cl's
+# /imsvc does), otherwise the CRT's stddef.h (non-constant offsetof) and
+# mmintrin.h (union __m64) shadow clang's. -I/-isystem search before the
+# resource dir; -internal-isystem appends after it.
+set(XWIN_CPU_FLAGS "-march=x86-64-v3" CACHE STRING "Target CPU flags")
+set(_cflags "${XWIN_CPU_FLAGS}")
+foreach(_d IN LISTS _inc)
+  string(APPEND _cflags " -Xclang -internal-isystem -Xclang \"${_d}\"")
+endforeach()
+# *_FLAGS_INIT is replaced by a user -DCMAKE_<LANG>_FLAGS; fail loudly then.
+foreach(_lang C CXX)
+  if(DEFINED CACHE{CMAKE_${_lang}_FLAGS} AND NOT "$CACHE{CMAKE_${_lang}_FLAGS}" MATCHES "internal-isystem")
+    message(FATAL_ERROR "Do not set CMAKE_${_lang}_FLAGS with this toolchain (it drops the Windows SDK headers); use XWIN_CPU_FLAGS")
+  endif()
+endforeach()
+set(CMAKE_C_FLAGS_INIT   "${_cflags}")
+set(CMAKE_CXX_FLAGS_INIT "${_cflags}")
+set(CMAKE_RC_STANDARD_INCLUDE_DIRECTORIES ${_inc})
+
+set(_lflags "-fuse-ld=lld")
+foreach(_d crt/lib/x86_64 sdk/lib/um/x86_64 sdk/lib/ucrt/x86_64)
+  string(APPEND _lflags " -L\"${XWIN_DIR}/${_d}\"")
+endforeach()
+set(CMAKE_EXE_LINKER_FLAGS_INIT    "${_lflags}")
+set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lflags}")
+set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lflags}")
+
+# Static MSVC runtime: the exe needs no VC++ redistributable on the target.
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>" CACHE STRING "")
+
+# Find libraries/headers only in the target environment, programs on the host.
+set(CMAKE_FIND_ROOT_PATH "${XWIN_DIR}")
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
+
+# xwin ships release CRT libs only (no libcmtd.lib); probe with a release config.
+set(CMAKE_TRY_COMPILE_CONFIGURATION RelWithDebInfo)
diff --git a/include/rex/audio/custom_music_player.h b/include/rex/audio/custom_music_player.h
new file mode 100644
index 0000000..5e4b0e5
--- /dev/null
+++ b/include/rex/audio/custom_music_player.h
@@ -0,0 +1,131 @@
+/**
+ ******************************************************************************
+ * ReXGlue runtime - custom (XMP) music playback
+ *
+ * Decodes Xbox 360 "user playlist" songs (the files a title enumerates from
+ * its music folder) and mixes them into the host audio output.
+ ******************************************************************************
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace rex::audio {
+
+// Decoded PCM, always stereo float at the host output rate.
+struct CustomMusicTrack {
+  std::vector<float> samples;  // interleaved LR
+  uint32_t sample_rate = 0;    // rate of the source file
+  uint32_t channels = 0;       // source channel count
+  uint64_t duration_ms = 0;
+  std::string decoder;         // "dr_mp3" / "dr_flac" / "dr_wav" / "stb_vorbis"
+};
+
+// Decodes a file to stereo float PCM at `target_rate`. Runs on whatever
+// thread calls it (the caller puts it on a worker). Returns nullptr and fills
+// `error` on failure.
+std::unique_ptr<CustomMusicTrack> DecodeCustomMusicFile(const std::filesystem::path& path,
+                                                        uint32_t target_rate, std::string* error);
+
+  // Plays at most one custom song at a time, mixed on top of guest audio.
+  //
+  // Threading: the public methods are called from the XMP app (guest thread) and
+  // the disk/SDL audio callback. The worker thread owns decoding; Play() only
+  // hands the request over (never decodes on the guest thread) and the mix
+  // callback only reads the lock-protected decoded samples.
+class CustomMusicPlayer {
+ public:
+  static CustomMusicPlayer& instance();
+
+  void Shutdown();
+
+  // Hands the decode request to the worker; decoding never runs on the
+  // calling (guest) thread. Returns false only if the player is shutting down
+  // or the request could not be queued; a decode failure is reported later in
+  // the log and surfaces as the state going back to idle.
+  bool Play(const std::filesystem::path& path, const std::string& name);
+  void Stop();
+  void Pause();
+  void Continue();
+
+  bool IsPlaying() const { return state_.load(std::memory_order_relaxed) == kPlaying; }
+  bool IsPaused() const { return state_.load(std::memory_order_relaxed) == kPaused; }
+  // True while decoded samples are being published/played (or loading). Lets
+  // the caller tell "Play() accepted" from "Play() rejected because shutdown".
+  bool IsActive() const {
+    uint32_t state = state_.load(std::memory_order_relaxed);
+    return state != kIdle && state != kFinished;
+  }
+
+  void SetVolume(float volume) {
+    volume_.store(std::clamp(volume, 0.0f, 1.0f), std::memory_order_relaxed);
+  }
+  float volume() const { return volume_.load(std::memory_order_relaxed); }
+
+  const std::string& name() const { return name_; }
+  const std::string& decoder() const { return decoder_; }
+  uint32_t sample_rate() const { return sample_rate_.load(std::memory_order_relaxed); }
+  uint64_t duration_ms() const { return duration_ms_.load(std::memory_order_relaxed); }
+
+  // Mixes up to `frames` stereo frames from the song into `output` (interleaved
+  // at `output_rate`, `output_channels` channels per frame). Called from the
+  // audio device callback. Adds the song on top of whatever is already in the
+  // buffer; does nothing when idle. `output_channels` must be >= 2; the song
+  // goes to front-left/front-right.
+  void MixFrames(float* output, uint32_t frames, uint32_t output_rate, uint32_t output_channels);
+
+ private:
+  enum State : uint32_t {
+    kIdle = 0,
+    kLoading = 3,
+    kPlaying = 1,
+    kPaused = 2,
+    kFinished = 4,
+  };
+
+  CustomMusicPlayer() = default;
+  ~CustomMusicPlayer();
+  CustomMusicPlayer(const CustomMusicPlayer&) = delete;
+  CustomMusicPlayer& operator=(const CustomMusicPlayer&) = delete;
+
+  void WorkerMain();
+
+  mutable std::mutex mutex_;
+  std::thread worker_;
+  bool worker_running_ = false;
+  std::atomic<uint32_t> state_{kIdle};
+
+  // Request handed to the worker.
+  std::filesystem::path request_path_;
+  std::string request_name_;
+  bool request_pending_ = false;
+  // Bumped by every Play()/Stop() so the worker can drop the result of a
+  // decode that has been superseded while it was running.
+  uint64_t request_serial_ = 0;
+
+  // Decoded samples (owned by the worker thread object, read under mutex_).
+  std::shared_ptr<CustomMusicTrack> track_;
+  size_t cursor_ = 0;  // in track samples
+
+  std::atomic<float> volume_{1.0f};
+  std::atomic<uint32_t> sample_rate_{0};  // source file rate (status/log only)
+  // Host device rate the track is resampled to; learned from MixFrames.
+  std::atomic<uint32_t> output_rate_{48000};
+  std::atomic<uint64_t> duration_ms_{0};
+  std::string name_;
+  std::string decoder_;
+
+  std::atomic<bool> shutdown_{false};
+  std::atomic<uint64_t> playback_generation_{0};
+};
+
+}  // namespace rex::audio
