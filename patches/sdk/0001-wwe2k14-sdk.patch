diff --git a/include/rex/diagnostics/freeze_logger.h b/include/rex/diagnostics/freeze_logger.h
new file mode 100644
index 0000000..a25e33c
--- /dev/null
+++ b/include/rex/diagnostics/freeze_logger.h
@@ -0,0 +1,90 @@
+/**
+ * @file        rex/diagnostics/freeze_logger.h
+ * @brief       Always-on freeze logger: a low-rate present watchdog plus a
+ *              lock-free ring of kernel synchronization events, written to a
+ *              report file when the game stops presenting. Intended for normal
+ *              player builds so a freeze anywhere records its own cause.
+ */
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+
+namespace rex::diagnostics::freeze_logger {
+
+// Kernel synchronization event kinds recorded in the ring buffer.
+enum class SyncType : uint32_t {
+  kUnknown = 0,
+  kEventCreate,
+  kEventSet,
+  kEventReset,
+  kEventPulse,
+  kSemaphoreRelease,
+  kWaitBegin,
+  kWaitEnd,
+  kThreadCreate,
+  kThreadExit,
+};
+
+// Starts the always-on logger: installs the one-shot capture signal handler and
+// a 1 Hz watchdog thread. No-op when already running, or when disabled with
+// WWE2K14_FREEZE_LOG=0 / REX_FREEZE_LOG_DISABLE=1.
+// Cheap and safe to call once.
+void Start();
+
+// Stops the watchdog (used at shutdown). Safe to call when never started.
+void Stop();
+
+// Writes an exit snapshot (same contents as a freeze report, file
+// wwe2k14-exit-<stamp>.txt, newest 3 kept) when the player closes the window.
+// Catches freezes where the picture stops but presents continue (GitHub
+// #21/#25), which the present-gap watchdog cannot see. Call before Stop() and
+// before the title is terminated. No-op when disabled or nothing was presented.
+void SnapshotOnClose();
+
+// True when the logger is running (not disabled by environment).
+bool IsEnabled();
+
+// Hot-path recorders. All are no-ops when the logger is disabled. They never
+// allocate, never take a lock, and only touch atomics + a fixed slot.
+void RecordPresent();
+void RecordVdSwap();
+void RecordSyncEvent(SyncType type, uint32_t handle, uint32_t object_type, const char* name);
+
+// Records the current guest thread as blocked on `handle` (object_type/name) and
+// then as unblocked. `guest_lr` is the guest link register at the wait call, a
+// useful proxity for the blocked guest PC (the recompiled runtime keeps no PC).
+void RecordWaitBegin(uint32_t handle, uint32_t object_type, const char* name, uint64_t guest_lr);
+void RecordWaitEnd(uint32_t handle);
+
+// Registers the calling host thread as a guest thread slot (for the report) and
+// unregisters it. Called from XThread's host trampoline.
+void RegisterThread(uint32_t guest_thread_id, const char* name);
+void UnregisterThread();
+
+// Total number of sync events pushed into the ring (overhead accounting).
+uint64_t RecordedEventCount();
+
+// --- Freeze-report extras -----------------------------------------------------
+
+// Optional guest-state provider installed by the game. When set, it is invoked
+// while the report file is open (before the log tail) so it can append
+// guest-memory-derived state (game objects, present-device fields, fixed
+// .data globals). It runs on the watchdog thread, which is NOT a
+// bound guest ThreadState, so the implementation must use a captured guest
+// memory base / Memory pointer rather than REX_KERNEL_MEMORY().
+using GuestStateDumpFn = void (*)(FILE* file, uint64_t now_ns);
+void SetGuestStateDumpFn(GuestStateDumpFn fn);
+
+// The access-violation recovery paths call this once per recovered page. Cheap
+// relaxed atomics + one timestamp; safe from any thread. The report prints the
+// per-kind count plus the last guest address / protect / age.
+enum class MemoryRecoveryKind : uint32_t {
+  kGuestVirtualStaleProtect = 0,
+  kReleasedPhysical,
+  kStalePhysical,
+  kCount,
+};
+void RecordMemoryRecovery(MemoryRecoveryKind kind, uint32_t guest_address, uint32_t protect);
+
+}  // namespace rex::diagnostics::freeze_logger
diff --git a/include/rex/diagnostics/rate_census.h b/include/rex/diagnostics/rate_census.h
new file mode 100644
index 0000000..28baff6
--- /dev/null
+++ b/include/rex/diagnostics/rate_census.h
@@ -0,0 +1,117 @@
+/**
+ * @file        rex/diagnostics/rate_census.h
+ * @brief       Optional per-second runtime rate census.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace rex::diagnostics::rate_census {
+
+struct Sample {
+  uint64_t t_ms = 0;
+  double vblank = 0.0;
+  double irq0 = 0.0;
+  double irq1 = 0.0;
+  double vdswap = 0.0;
+  double present = 0.0;
+  double guest_ticks_per_s = 0.0;
+  double guest_ms_per_s = 0.0;
+  uint64_t vblank_interval_ticks = 0;
+  double refresh_hz = 0.0;
+  double gpu_busy_ms = 0.0;
+  double gpu_wait_ms = 0.0;
+  uint64_t gpu_wait_count = 0;
+  double swap_wait_ms = 0.0;
+  double submission_worker_busy_ms = 0.0;
+  double submission_worker_jobs_per_s = 0.0;
+  uint32_t vdswap_tid = 0;
+  double vdswap_thread_cpu_pct = 0.0;
+  // Exclusive wall time per second spent by the GPU command thread in each
+  // CpPhase (nested phases are subtracted from their parent).
+  double cp_phase_ms[6] = {};
+  uint64_t cp_wait_reg_mem_count = 0;
+};
+
+// Command processor phases timed by ScopedCpPhase.
+enum class CpPhase : uint32_t {
+  kWaitRegMem = 0,  // Guest WAIT_REG_MEM not satisfied on the first poll.
+  kDraw,            // IssueDraw minus nested phases.
+  kCopy,            // IssueCopy (resolves) minus nested phases.
+  kSwap,            // IssueSwap minus nested phases.
+  kSubmit,          // EndSubmission (host queue submit).
+  kSubmitDrain,     // CP time waiting for the asynchronous submit worker.
+  kCount,
+};
+
+// Starts the census when WWE2K14_RATE_CENSUS is exactly "1". The environment is
+// sampled once by this call; event recording is otherwise a no-op when the
+// census is disabled.
+void Start(uint64_t vblank_interval_ticks, double refresh_rate_hz);
+
+// Stops the reporting thread. Safe to call when Start was never enabled.
+void Stop();
+
+// Returns the most recent complete one-second sample, if one has been
+// published. The sample is updated by the census thread once per second.
+std::optional<Sample> GetLatestSample();
+
+void RecordVblank();
+void RecordInterrupt(uint32_t source);
+void RecordVdSwap();
+// Presentation interval requested by the game for the current swap.
+void RecordPresentInterval(uint32_t interval);
+void RecordPresent();
+void RecordGpuBusyStart();
+void RecordGpuBusyEnd();
+void RecordGpuWaitStart();
+void RecordGpuWaitEnd();
+void RecordSubmissionWorkerBusyStart();
+void RecordSubmissionWorkerBusyEnd();
+void RecordSubmissionWorkerJob();
+// Records one successful texture descriptor-set update or reuse for the
+// vertex (true) or pixel (false) shader stage.
+void RecordDescriptorSetUpdate(bool is_vertex, bool reused);
+
+bool IsEnabled();
+uint64_t NowNs();
+void CpPhaseEnter(CpPhase phase, uint64_t now_ns);
+void CpPhaseExit(uint64_t now_ns);
+// Records one unsatisfied WAIT_REG_MEM: poll target (register index, or
+// physical address with is_memory), total time it blocked, the per-iteration
+// sleep payload in milliseconds, and the number and sum of poll iterations.
+void RecordWaitRegMem(bool is_memory, uint32_t poll_addr, uint64_t wait_ns,
+                      uint64_t payload_ms, uint64_t iterations,
+                      uint64_t payload_ms_sum);
+// Global critical region contention (called by global_critical_region when the
+// census is on): owner is the host tid holding the lock (0 if unknown).
+// OnGlobalLockContended may send SIGPROF to the owner (WWE2K14_LOCK_OWNER_SAMPLE=1,
+// only when a SIGPROF handler is installed, i.e. WWE2K14_THREAD_PROFILE is set) so
+// the thread profiler records what the owner is doing.
+void OnGlobalLockContended(uint32_t owner_tid);
+void RecordGlobalLockWait(uint32_t owner_tid, uint64_t wait_ns);
+
+// Times a command processor phase when the census is enabled; a no-op
+// otherwise. Must be used on the GPU command thread only.
+class ScopedCpPhase {
+ public:
+  explicit ScopedCpPhase(CpPhase phase) : active_(IsEnabled()) {
+    if (active_) {
+      CpPhaseEnter(phase, NowNs());
+    }
+  }
+  ~ScopedCpPhase() {
+    if (active_) {
+      CpPhaseExit(NowNs());
+    }
+  }
+  ScopedCpPhase(const ScopedCpPhase&) = delete;
+  ScopedCpPhase& operator=(const ScopedCpPhase&) = delete;
+
+ private:
+  bool active_;
+};
+
+}  // namespace rex::diagnostics::rate_census
