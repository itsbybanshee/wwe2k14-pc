Subject: [PATCH 2/2] Input: Optimize controller repeat timings and implement
 full keyboard playability

---
 include/rex/input/sdl/sdl_input_driver.h |   4 +-
 src/input/mnk/mnk_input_driver.cpp       | 147 +++++++++++++++++------
 2 files changed, 111 insertions(+), 40 deletions(-)

diff --git a/include/rex/input/sdl/sdl_input_driver.h b/include/rex/input/sdl/sdl_input_driver.h
index 227acf1..7f15d51 100644
--- a/include/rex/input/sdl/sdl_input_driver.h
+++ b/include/rex/input/sdl/sdl_input_driver.h
@@ -26,8 +26,8 @@
 #define HID_SDL_USER_COUNT 4
 #define HID_SDL_THUMB_THRES 0x4E00
 #define HID_SDL_TRIGG_THRES 0x1F
-#define HID_SDL_REPEAT_DELAY 400
-#define HID_SDL_REPEAT_RATE 100
+#define HID_SDL_REPEAT_DELAY 220
+#define HID_SDL_REPEAT_RATE 45
 
 namespace rex::input::sdl {
 
diff --git a/src/input/mnk/mnk_input_driver.cpp b/src/input/mnk/mnk_input_driver.cpp
index f0fd1e5..8572045 100644
--- a/src/input/mnk/mnk_input_driver.cpp
+++ b/src/input/mnk/mnk_input_driver.cpp
@@ -29,36 +29,36 @@
 #include <Windows.h>
 #endif
 
-REXCVAR_DEFINE_BOOL(mnk_mode, false, "Input", "Enable keyboard/mouse controller emulation");
+REXCVAR_DEFINE_BOOL(mnk_mode, true, "Input", "Enable keyboard/mouse controller emulation");
 REXCVAR_DEFINE_BOOL(mnk_mouse, false, "Input", "Mouse drives the right stick (captures the cursor)");
 REXCVAR_DEFINE_INT32(mnk_user_index, 0, "Input", "Controller slot (0-3) for MnK").range(0, 3);
 REXCVAR_DEFINE_DOUBLE(mnk_sensitivity, 1.0, "Input", "Mouse sensitivity for right stick")
     .range(0.01, 10.0);
 
 REXCVAR_DEFINE_STRING(keybind_a, "Space", "Input/Keybinds/Controller", "A button");
-REXCVAR_DEFINE_STRING(keybind_b, "Shift", "Input/Keybinds/Controller", "B button");
-REXCVAR_DEFINE_STRING(keybind_x, "R", "Input/Keybinds/Controller", "X button");
-REXCVAR_DEFINE_STRING(keybind_y, "E", "Input/Keybinds/Controller", "Y button");
-REXCVAR_DEFINE_STRING(keybind_left_trigger, "Z", "Input/Keybinds/Controller", "Left trigger");
-REXCVAR_DEFINE_STRING(keybind_right_trigger, "Control", "Input/Keybinds/Controller", "Right trigger");
+REXCVAR_DEFINE_STRING(keybind_b, "Backspace", "Input/Keybinds/Controller", "B button");
+REXCVAR_DEFINE_STRING(keybind_x, "J", "Input/Keybinds/Controller", "X button");
+REXCVAR_DEFINE_STRING(keybind_y, "I", "Input/Keybinds/Controller", "Y button");
+REXCVAR_DEFINE_STRING(keybind_left_trigger, "Shift", "Input/Keybinds/Controller", "Left trigger");
+REXCVAR_DEFINE_STRING(keybind_right_trigger, "F", "Input/Keybinds/Controller", "Right trigger");
 REXCVAR_DEFINE_STRING(keybind_left_shoulder, "Q", "Input/Keybinds/Controller", "Left shoulder");
-REXCVAR_DEFINE_STRING(keybind_right_shoulder, "F", "Input/Keybinds/Controller", "Right shoulder");
+REXCVAR_DEFINE_STRING(keybind_right_shoulder, "E", "Input/Keybinds/Controller", "Right shoulder");
 REXCVAR_DEFINE_STRING(keybind_lstick_up, "W", "Input/Keybinds/Controller", "Left stick up");
 REXCVAR_DEFINE_STRING(keybind_lstick_down, "S", "Input/Keybinds/Controller", "Left stick down");
 REXCVAR_DEFINE_STRING(keybind_lstick_left, "A", "Input/Keybinds/Controller", "Left stick left");
 REXCVAR_DEFINE_STRING(keybind_lstick_right, "D", "Input/Keybinds/Controller", "Left stick right");
 REXCVAR_DEFINE_STRING(keybind_lstick_press, "C", "Input/Keybinds/Controller", "Left stick press");
-REXCVAR_DEFINE_STRING(keybind_rstick_up, "I", "Input/Keybinds/Controller", "Right stick up");
-REXCVAR_DEFINE_STRING(keybind_rstick_down, "K", "Input/Keybinds/Controller", "Right stick down");
-REXCVAR_DEFINE_STRING(keybind_rstick_left, "J", "Input/Keybinds/Controller", "Right stick left");
-REXCVAR_DEFINE_STRING(keybind_rstick_right, "L", "Input/Keybinds/Controller", "Right stick right");
-REXCVAR_DEFINE_STRING(keybind_rstick_press, "M", "Input/Keybinds/Controller", "Right stick press");
+REXCVAR_DEFINE_STRING(keybind_rstick_up, "Numpad8", "Input/Keybinds/Controller", "Right stick up");
+REXCVAR_DEFINE_STRING(keybind_rstick_down, "Numpad2", "Input/Keybinds/Controller", "Right stick down");
+REXCVAR_DEFINE_STRING(keybind_rstick_left, "Numpad4", "Input/Keybinds/Controller", "Right stick left");
+REXCVAR_DEFINE_STRING(keybind_rstick_right, "Numpad6", "Input/Keybinds/Controller", "Right stick right");
+REXCVAR_DEFINE_STRING(keybind_rstick_press, "Numpad5", "Input/Keybinds/Controller", "Right stick press");
 REXCVAR_DEFINE_STRING(keybind_dpad_up, "Up", "Input/Keybinds/Controller", "D-pad up");
 REXCVAR_DEFINE_STRING(keybind_dpad_down, "Down", "Input/Keybinds/Controller", "D-pad down");
 REXCVAR_DEFINE_STRING(keybind_dpad_left, "Left", "Input/Keybinds/Controller", "D-pad left");
 REXCVAR_DEFINE_STRING(keybind_dpad_right, "Right", "Input/Keybinds/Controller", "D-pad right");
 REXCVAR_DEFINE_STRING(keybind_back, "Tab", "Input/Keybinds/Controller", "Back button");
-REXCVAR_DEFINE_STRING(keybind_start, "Escape", "Input/Keybinds/Controller", "Start button");
+REXCVAR_DEFINE_STRING(keybind_start, "Return", "Input/Keybinds/Controller", "Start button");
 REXCVAR_DEFINE_STRING(keybind_guide, "", "Input/Keybinds/Controller", "Guide button");
 
 namespace rex::input::mnk {
@@ -86,6 +86,28 @@ bool IsControlKeyDown(const bool (&key_down)[256]) {
          key_down[static_cast<uint16_t>(VirtualKey::kRControl)];
 }
 
+VirtualKey GetPadVirtualKey(VirtualKey k) {
+  switch (k) {
+    case VirtualKey::kReturn: return VirtualKey::kXInputPadStart;
+    case VirtualKey::kEscape: return VirtualKey::kXInputPadB;
+    case VirtualKey::kBack: return VirtualKey::kXInputPadB;
+    case VirtualKey::kSpace: return VirtualKey::kXInputPadA;
+    case VirtualKey::kK: return VirtualKey::kXInputPadA;
+    case VirtualKey::kL: return VirtualKey::kXInputPadB;
+    case VirtualKey::kJ: return VirtualKey::kXInputPadX;
+    case VirtualKey::kI: return VirtualKey::kXInputPadY;
+    case VirtualKey::kUp:
+    case VirtualKey::kW: return VirtualKey::kXInputPadDpadUp;
+    case VirtualKey::kDown:
+    case VirtualKey::kS: return VirtualKey::kXInputPadDpadDown;
+    case VirtualKey::kLeft:
+    case VirtualKey::kA: return VirtualKey::kXInputPadDpadLeft;
+    case VirtualKey::kRight:
+    case VirtualKey::kD: return VirtualKey::kXInputPadDpadRight;
+    default: return VirtualKey::kNone;
+  }
+}
+
 }  // namespace
 
 MnkInputDriver::MnkInputDriver(rex::ui::Window* window, size_t window_z_order)
@@ -160,6 +182,14 @@ static bool IsUiKeystrokeKey(uint16_t vk) {
     case VirtualKey::kUp:
     case VirtualKey::kRight:
     case VirtualKey::kDown:
+    case VirtualKey::kW:
+    case VirtualKey::kA:
+    case VirtualKey::kS:
+    case VirtualKey::kD:
+    case VirtualKey::kJ:
+    case VirtualKey::kK:
+    case VirtualKey::kL:
+    case VirtualKey::kI:
       return true;
     default:
       return false;
@@ -278,63 +308,94 @@ X_RESULT MnkInputDriver::GetState(uint32_t user_index, X_INPUT_STATE* out_state)
     return X_ERROR_SUCCESS;
   }
 
+  auto is_key = [&](VirtualKey vk) -> bool {
+    uint16_t idx = static_cast<uint16_t>(vk);
+    return idx < 256 && key_down_[idx];
+  };
+
   uint16_t buttons = 0;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_a)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_a)) || is_key(VirtualKey::kReturn) ||
+      is_key(VirtualKey::kSpace) || is_key(VirtualKey::kK) || is_key(VirtualKey::kNumpad1))
     buttons |= X_INPUT_GAMEPAD_A;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_b)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_b)) || is_key(VirtualKey::kEscape) ||
+      is_key(VirtualKey::kBack) || is_key(VirtualKey::kL) || is_key(VirtualKey::kNumpad2))
     buttons |= X_INPUT_GAMEPAD_B;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_x)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_x)) || is_key(VirtualKey::kJ) ||
+      is_key(VirtualKey::kX) || is_key(VirtualKey::kNumpad4))
     buttons |= X_INPUT_GAMEPAD_X;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_y)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_y)) || is_key(VirtualKey::kI) ||
+      is_key(VirtualKey::kU) || is_key(VirtualKey::kNumpad5))
     buttons |= X_INPUT_GAMEPAD_Y;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_left_shoulder)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_left_shoulder)) || is_key(VirtualKey::kQ) ||
+      is_key(VirtualKey::kC))
     buttons |= X_INPUT_GAMEPAD_LEFT_SHOULDER;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_right_shoulder)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_right_shoulder)) || is_key(VirtualKey::kE) ||
+      is_key(VirtualKey::kR) || is_key(VirtualKey::kTab))
     buttons |= X_INPUT_GAMEPAD_RIGHT_SHOULDER;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_press)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_press)) || is_key(VirtualKey::kO))
     buttons |= X_INPUT_GAMEPAD_LEFT_THUMB;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_press)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_press)) || is_key(VirtualKey::kP))
     buttons |= X_INPUT_GAMEPAD_RIGHT_THUMB;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_back)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_back)) || is_key(VirtualKey::kBack) ||
+      is_key(VirtualKey::kM))
     buttons |= X_INPUT_GAMEPAD_BACK;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_start)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_start)) || is_key(VirtualKey::kReturn) ||
+      is_key(VirtualKey::kEscape))
     buttons |= X_INPUT_GAMEPAD_START;
   if (IsBindPressed(key_down_, REXCVAR_GET(keybind_guide)))
     buttons |= X_INPUT_GAMEPAD_GUIDE;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_up)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_up)) || is_key(VirtualKey::kUp) ||
+      is_key(VirtualKey::k1))
     buttons |= X_INPUT_GAMEPAD_DPAD_UP;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_down)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_down)) || is_key(VirtualKey::kDown) ||
+      is_key(VirtualKey::k2))
     buttons |= X_INPUT_GAMEPAD_DPAD_DOWN;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_left)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_left)) || is_key(VirtualKey::kLeft) ||
+      is_key(VirtualKey::k3))
     buttons |= X_INPUT_GAMEPAD_DPAD_LEFT;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_right)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_right)) || is_key(VirtualKey::kRight) ||
+      is_key(VirtualKey::k4))
     buttons |= X_INPUT_GAMEPAD_DPAD_RIGHT;
 
-  uint8_t lt = IsBindPressed(key_down_, REXCVAR_GET(keybind_left_trigger)) ? 0xFF : 0;
-  uint8_t rt = IsBindPressed(key_down_, REXCVAR_GET(keybind_right_trigger)) ? 0xFF : 0;
+  const bool lt_pressed = IsBindPressed(key_down_, REXCVAR_GET(keybind_left_trigger)) ||
+                          is_key(VirtualKey::kShift) || is_key(VirtualKey::kLShift) ||
+                          is_key(VirtualKey::kRShift) || is_key(VirtualKey::kZ);
+  const bool rt_pressed = IsBindPressed(key_down_, REXCVAR_GET(keybind_right_trigger)) ||
+                          is_key(VirtualKey::kControl) || is_key(VirtualKey::kLControl) ||
+                          is_key(VirtualKey::kRControl) || is_key(VirtualKey::kF);
+  uint8_t lt = lt_pressed ? 0xFF : 0;
+  uint8_t rt = rt_pressed ? 0xFF : 0;
 
   int32_t lx = 0;
   int32_t ly = 0;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_left)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_left)) || is_key(VirtualKey::kA) ||
+      is_key(VirtualKey::kLeft))
     lx -= INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_right)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_right)) || is_key(VirtualKey::kD) ||
+      is_key(VirtualKey::kRight))
     lx += INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_up)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_up)) || is_key(VirtualKey::kW) ||
+      is_key(VirtualKey::kUp))
     ly += INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_down)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_down)) || is_key(VirtualKey::kS) ||
+      is_key(VirtualKey::kDown))
     ly -= INT16_MAX;
 
   double sensitivity = REXCVAR_GET(mnk_sensitivity);
   constexpr double kBaseScale = 200.0;
   int32_t rx = 0;
   int32_t ry = 0;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_left)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_left)) || is_key(VirtualKey::kNumpad4) ||
+      is_key(VirtualKey::kV))
     rx -= INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_right)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_right)) || is_key(VirtualKey::kNumpad6) ||
+      is_key(VirtualKey::kB))
     rx += INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_up)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_up)) || is_key(VirtualKey::kNumpad8) ||
+      is_key(VirtualKey::kT))
     ry += INT16_MAX;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_down)))
+  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_down)) || is_key(VirtualKey::kNumpad2) ||
+      is_key(VirtualKey::kG))
     ry -= INT16_MAX;
   rx += static_cast<int32_t>(mouse_dx_ * sensitivity * kBaseScale);
   ry += static_cast<int32_t>(-mouse_dy_ * sensitivity * kBaseScale);
@@ -493,7 +554,13 @@ void MnkInputDriver::OnKeyDown(rex::ui::KeyEvent& e) {
     // ignored until the matching key-up so a held shortcut pastes only once.
     SetKeyState(vk, !ctrl_v);
     if (!ctrl_v && IsUiKeystrokeKey(vk)) {
-      EnqueueKeystroke(vk, true);
+      EnqueueKeystroke(vk, true, 0, e.prev_state());
+    }
+    if (!ctrl_v) {
+      VirtualKey pad_vk = GetPadVirtualKey(static_cast<VirtualKey>(vk));
+      if (pad_vk != VirtualKey::kNone) {
+        EnqueueKeystroke(static_cast<uint16_t>(pad_vk), true, 0, e.prev_state());
+      }
     }
     if (!ctrl_v && !e.prev_state()) {
       switch (static_cast<VirtualKey>(vk)) {
@@ -554,6 +621,10 @@ void MnkInputDriver::OnKeyUp(rex::ui::KeyEvent& e) {
   if (IsUiKeystrokeKey(vk)) {
     EnqueueKeystroke(vk, false);
   }
+  VirtualKey pad_vk = GetPadVirtualKey(static_cast<VirtualKey>(vk));
+  if (pad_vk != VirtualKey::kNone) {
+    EnqueueKeystroke(static_cast<uint16_t>(pad_vk), false);
+  }
 }
 
 void MnkInputDriver::OnKeyChar(rex::ui::KeyEvent& e) {
