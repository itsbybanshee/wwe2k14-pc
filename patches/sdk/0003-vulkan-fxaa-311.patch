+  } else {
+    finalUv.x += (isNegSteeper ? -finalOffset : finalOffset) * texel.x;
   }
 
+  vec3 result = textureLod(xe_fxaa_source, finalUv, 0.0).rgb;
   imageStore(xe_fxaa_dest, ivec2(pixel), vec4(result, 1.0));
 }
 )";
