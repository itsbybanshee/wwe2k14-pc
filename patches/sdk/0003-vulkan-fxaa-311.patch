   uvec2 pixel = gl_GlobalInvocationID.xy;
@@ -631,42 +680,105 @@ void main() {
   vec2 uv = (vec2(pixel) + vec2(0.5)) * xe_fxaa_size_inv;
   vec2 texel = xe_fxaa_size_inv;
   vec4 rgbm = textureLod(xe_fxaa_source, uv, 0.0);
-
